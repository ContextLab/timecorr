# The plot style of the timecorr tutorials: plt.style.use('timecorr.tutorial')
# Colors: the colorblind-safe palette of Okabe and Ito
figure.dpi: 100
font.size: 11
axes.titlesize: 12
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['0072B2', 'E69F00', '009E73', 'D55E00', '56B4E9', 'CC79A7', '000000'])
legend.frameon: False
